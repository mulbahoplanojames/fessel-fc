# Prisma / MongoDB
DATABASE_URL="mongodb+srv://username:password@cluster.mongodb.net/fessel-fc"

# Better Auth
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# OAuth providers (optional; leave blank to disable that provider)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# Cloudinary
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Email (SMTP) — used for receipts, notifications, verification & reset emails.
# If SMTP_HOST is left blank, emails are skipped (logged) in development.
SMTP_HOST="smtp.yourprovider.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-smtp-username"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM="Fessel FC <no-reply@fcfassell.com>"

# Used by client-side API helpers
NEXT_PUBLIC_BASE_URI="http://localhost:3000"

# Next.js sets this automatically; include it only when overriding locally.
NODE_ENV="development"